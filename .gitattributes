# Text files are LF in the repository and in the working tree.
* text=auto eol=lf
*.pdf  binary
*.zip  binary

# Keep Windows shell artifacts with CRLF where they must run there.
*.ps1  text eol=crlf

# Language stats: mapa_mty.html is generated by scripts/mapa_mty.py, and
# scripts/_leaflet/ is vendored Leaflet (embedded into the map at build time).
insights/*.html    linguist-generated=true
scripts/_leaflet/** linguist-vendored=true
